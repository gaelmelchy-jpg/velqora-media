# Supabase project settings (Project Settings → API in the Supabase dashboard) —
# same project as the Velqora CRM app, different tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never exposed to the client. Keep this out of git.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP for the contact form's auto-reply + internal notification.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
NOTIFY_TO_EMAIL=
